{
  "name": "@memory-weave/browser-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "memory-weave-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@memory-weave/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsc-alias": "1.9.9",
    "typescript": "~5.9.3"
  }
}
