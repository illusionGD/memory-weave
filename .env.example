# 推荐运行 pnpm setup 自动生成独立的本地密码；本文件不包含可直接使用的凭据。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
DATABASE_URL=
QDRANT_PORT=6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
ADMIN_PASSWORD=

# 模型为可选配置；复制 deploy/models.env.example 为 .env.models 后填写。
# dev、start 和 Docker 应用会加载该文件；未配置时仍可验收确定性测试模型。

# pnpm dev 使用 5173；pnpm start 使用 3000 时需同步调整 APP_ORIGIN。
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
DATA_DIR=./data

# Docker 完整部署的入口。公网部署时设置真实 HTTPS origin 和安全 Cookie。
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
DEPLOY_APP_ORIGIN=http://localhost:8080
DEPLOY_COOKIE_SECURE=false

# 聊天资源配置（可选），修改后重启；正在执行的轮次使用原快照。
CHAT_CONFIG_JSON='{"mergeWindowMs":300,"maxMergeWaitMs":1500,"historyMessages":200,"publishChunkChars":256,"publishIntervalMs":100,"eventPollMs":250,"maxEventConnections":8}'

# 生命周期每批清理记录数（1–500）；进度逐批提交。
LIFECYCLE_BATCH_SIZE=100

# 记忆整理（可选），每批保存快照；不是每条消息都调用模型。
MEMORY_CONFIG_JSON='{"enabled":true,"idleMs":30000,"maxWaitMs":300000,"messageThreshold":16,"characterThreshold":12000,"maxMessages":24,"maxInputCharacters":24000,"contextMessages":4,"relatedMemories":12}'
