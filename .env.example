# 推荐运行 pnpm setup 自动生成独立的本地密码；本文件不包含可直接使用的凭据。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
DATABASE_URL=
QDRANT_PORT=6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
ADMIN_PASSWORD=

# pnpm dev 使用 5173；pnpm start 使用 3000 时需同步调整 APP_ORIGIN。
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
DATA_DIR=./data

# Docker 完整部署的入口。公网部署时设置真实 HTTPS origin 和安全 Cookie。
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
DEPLOY_APP_ORIGIN=http://localhost:8080
DEPLOY_COOKIE_SECURE=false
