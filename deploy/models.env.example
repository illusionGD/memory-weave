# 可选：复制为仓库根目录 .env.models。未配置时仅使用不联网的 test adapter。
# 生成与 embedding 能力应按供应商实际支持情况声明；密钥仅留在本文件。
MODEL_PROVIDERS_JSON=[]
# 示例（替换上面一行，模型名称和价格在持久配置中设置）：
# MODEL_PROVIDERS_JSON='[{"id":"openai","baseUrl":"https://api.openai.com/v1","apiKeyEnv":"MODEL_OPENAI_API_KEY","capabilities":["text","structured","embedding"],"outputTokenParameter":"max_completion_tokens","structuredFormat":"json_schema","sendEmbeddingDimensions":true,"streaming":true}]'
# streaming 只在供应商支持 Chat Completions SSE（含结束标志）时启用；省略或 false 则整段返回。
MODEL_OPENAI_API_KEY=

# 部署资源硬上限；单位为请求数、token 数和微美元（1 美元 = 1000000 微美元）。
# 普通模型配置可以降低这些值，不能提高；固定 UTC 日窗口不会随时区设置重置。
MODEL_HARD_LIMITS_JSON='{"dailyBudget":{"requests":10000,"tokens":10000000,"costMicros":10000000},"maxConcurrent":4,"backgroundConcurrent":1}'
